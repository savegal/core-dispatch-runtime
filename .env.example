# Copy this file to .env and fill real values. Never commit .env.

ENV=production
DEBUG=false

# New orders use HTTP only; browser video traffic is blocked.
USE_BAS=false
TIKTOK_NETWORK_FIRST=true
TIKTOK_NETWORK_IMPL_READY=true
PARALLEL_COMMENTING_DOM_FIRST=false
BLOCK_MEDIA=true
BLOCK_IMAGES=true
BLOCK_FONTS=true

DB_URL=sqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0
REDIS_TASK_QUEUE=queue:tasks

EXECUTOR_API_TOKEN=change-me-executor-token
ADMIN_API_TOKEN=change-me-admin-token
JWT_SECRET=change-me-long-random-secret

BOT_TOKEN=123456:replace-with-botfather-token
API_BASE=http://localhost:8000
API_JWT=
OWNER_TELEGRAM_ID=
TELEGRAM_PROXY=

DEMO_MODE=false
# For a temporary direct connection test set False; saved proxy assignments are kept.
USE_PROXY=true
PLAYWRIGHT_HEADLESS=true
VALIDATE_BEFORE_TASK=true
VALIDATE_PROXY_BEFORE_TASK=true
MAX_RETRY_ACCOUNTS=3
# Account country from cookies. Empty disables the tie-break preference.
PREFERRED_ACCOUNT_COUNTRIES=FR,ES,GB,DE,IT,PL,NL,US
