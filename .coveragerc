[run]
source = .
omit = 
    tests/*
    __pycache__/*
    */__pycache__/*
    */site-packages/*
    */venv/*
    */env/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod




