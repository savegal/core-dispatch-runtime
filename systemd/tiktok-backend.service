[Unit]
Description=TikTok Comment Service Backend API
After=network.target redis.service postgresql.service
Wants=redis.service

[Service]
Type=simple
User=tiktok
Group=tiktok
WorkingDirectory=/opt/tiktok-service
Environment="PATH=/opt/tiktok-service/venv/bin"
EnvironmentFile=/opt/tiktok-service/.env
ExecStart=/opt/tiktok-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tiktok-backend

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target



